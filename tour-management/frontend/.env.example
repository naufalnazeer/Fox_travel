# Copy this file to .env.local (same folder) and fill in your Supabase project's
# values — see ../supabase/SETUP.md for exactly where to find them.
# .env.local is already gitignored by Create React App, so these never get committed.

REACT_APP_SUPABASE_URL=https://xxxxxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key
